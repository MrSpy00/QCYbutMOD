# aegisSoft QCYbutMOD - Keystore Signing Template
# Copy this file to 'keystore.properties' and fill in your signing credentials:
# (Note: 'keystore.properties' is gitignored to protect your private signing keys)

storeFile=release/your-keystore.jks
storePassword=your-keystore-password
keyAlias=your-key-alias
keyPassword=your-key-password
